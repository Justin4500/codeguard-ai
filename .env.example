# ---------------------------------------------------------------------------
# CodeGuard AI environment configuration example.
# Copy this file to ".env" in the project root and edit as needed.
# The application works fully WITHOUT any of the AI values below.
# NEVER put a real API key in this file - it is committed to source control.
# ---------------------------------------------------------------------------

# --- Security ---
# IMPORTANT: change this to a long random value in production.
SECRET_KEY=change-me-in-production-please-set-a-real-secret

# --- Database ---
# Defaults to backend/storage/codeguard.db (SQLite). Leave empty to use default.
# DATABASE_URL=sqlite:///./storage/codeguard.db

# --- Frontend origins allowed by CORS ---
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional AI provider (OpenAI-compatible). Leave blank to run offline. ---
# Example: Groq
# AI_PROVIDER=groq
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=your-key-here
# AI_MODEL=openai/gpt-oss-120b
#
# Example: OpenRouter
# AI_PROVIDER=openrouter
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=your-key-here
# AI_MODEL=google/gemma-3-27b-it:free
#
# Example: DeepSeek
# AI_PROVIDER=deepseek
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=your-key-here
# AI_MODEL=deepseek-chat
#
# Example: Alibaba Qwen (DashScope OpenAI-compatible)
# AI_PROVIDER=qwen
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-plus
#
# Example: SiliconFlow
# AI_PROVIDER=siliconflow
# AI_BASE_URL=https://api.siliconflow.cn/v1
# AI_MODEL=Qwen/Qwen2.5-7B-Instruct
#
# Example: Google Gemini (OpenAI-compatible endpoint)
# AI_PROVIDER=gemini
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-1.5-flash

AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Scanning limits (tuned for low-resource machines) ---
MAX_REPO_SIZE_MB=200
MAX_FILES=2500
MAX_FILE_SIZE_KB=512
MAX_CONCURRENT_SCANS=2
